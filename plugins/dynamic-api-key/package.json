{
  "name": "opencode-dynamic-api-key",
  "version": "0.1.1",
  "description": "Fail-closed, on-demand dynamic API keys for OpenCode v2 Session HTTP and WebSocket requests",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./server.js"
    }
  },
  "files": [
    "server.js",
    "dist",
    "README.md",
    "examples"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "node scripts/integration.mjs",
    "compile": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.32"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaofeng-zheng/opencode-plugin.git",
    "directory": "plugins/dynamic-api-key"
  },
  "homepage": "https://github.com/xiaofeng-zheng/opencode-plugin/tree/main/plugins/dynamic-api-key",
  "bugs": {
    "url": "https://github.com/xiaofeng-zheng/opencode-plugin/issues"
  },
  "license": "UNLICENSED"
}
